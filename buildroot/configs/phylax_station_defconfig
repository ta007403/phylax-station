# PHYLAX station, Buildroot image - milestone 1: boots the CM5 to a console (dev).
# Based on Buildroot's raspberrypicm5io_defconfig.

# CPU and toolchain: glibc (PHYLAX Suite / Electron needs it), prebuilt by Bootlin
BR2_aarch64=y
BR2_cortex_a76=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_CCACHE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="phylax-station"
BR2_TARGET_GENERIC_ISSUE="PHYLAX station (Buildroot)"
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Asia/Bangkok"
# root cannot log in; dev image: the console user admin (sudo)
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_PHYLAX_PATH)/board/phylax-station/users.table"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PHYLAX_PATH)/board/phylax-station/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PHYLAX_PATH)/board/phylax-station/post-image.sh"

# Kernel: Raspberry Pi's, as pinned by Buildroot for the CM5; every CM5 device tree (the firmware
# picks the one for the module), so it is not tied to the CM5 IO board
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-cm5-cm5io broadcom/bcm2712-rpi-cm5l-cm5io broadcom/bcm2712-rpi-cm5-cm4io broadcom/bcm2712-rpi-cm5l-cm4io"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Boot partition: Raspberry Pi firmware files, our config.txt / cmdline.txt, device tree overlays
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PHYLAX_PATH)/board/phylax-station/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_PHYLAX_PATH)/board/phylax-station/cmdline.txt"
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y

# Packages (milestone 1: only what boots and lets us look around)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_USBUTILS=y

# System partition
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for the image
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
