# PHYLAX station (Buildroot image): PHYLAX Suite fullscreen on the screen (tty1), in the cage kiosk
# compositor, as the kiosk user. Restarted if it closes.
# As the Raspberry Pi OS image's rootfs/etc/systemd/system/phylax-kiosk.service, but without the
# data partition's mounts (they come with milestone 4).
[Unit]
Description=PHYLAX Suite kiosk
After=systemd-user-sessions.service
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=phylax
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XKB_DEFAULT_LAYOUT=us
Environment=LANG=en_US.UTF-8
# -s: Ctrl+Alt+F2 switches to the console (dev images: log in)
ExecStart=/usr/bin/cage -s -- /usr/local/bin/phylax-suite
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
