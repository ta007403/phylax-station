# PHYLAX station (Buildroot image): boot (FAT) and system partitions.
# The system partition is read-only on the station (phylax-overlay-init); the data partition is
# last, so it can grow to fill the eMMC at the first start (phylax-grow-data).
image boot.vfat {
	vfat {
		label = "bootfs"
		files = {
#BOOT_FILES#
		}
	}

	size = 64M
}

image sdcard.img {
	hdimage {
		# fixed, so cmdline.txt can name the system partition: root=PARTUUID=50485958-02
		disk-signature = 0x50485958
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
