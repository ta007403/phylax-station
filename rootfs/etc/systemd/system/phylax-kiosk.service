# PHYLAX station: PHYLAX Suite fullscreen on the screen (tty1), in the cage kiosk compositor,
# as the kiosk user. Restarted if it closes.
[Unit]
Description=PHYLAX Suite kiosk
After=systemd-user-sessions.service plymouth-quit-wait.service data.mount home-phylax.mount
Requires=home-phylax.mount
Wants=dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=phylax
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XKB_DEFAULT_LAYOUT=us
# -s: Ctrl+Alt+F2 switches to the console (dev images: log in, nmtui for Wi-Fi)
ExecStart=/usr/bin/cage -s -- /usr/local/bin/phylax-suite
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
