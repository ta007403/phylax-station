# PHYLAX station: SSH host keys, made on the station's first start and kept on the data partition
# (the system partition is read-only), copied in at every start.
[Unit]
Description=PHYLAX station SSH host keys
After=data.mount
Requires=data.mount
Before=ssh.service sshd-keygen.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/phylax-ssh-keys

[Install]
WantedBy=multi-user.target
