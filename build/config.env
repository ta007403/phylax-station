# PHYLAX station image settings. build-image.sh reads this file.

# Base: official Raspberry Pi OS Lite 64-bit. "latest" follows Raspberry Pi's redirect to the
# newest release; set a full .img.xz URL to pin one. Its published .sha256 is always checked.
PI_OS_URL="https://downloads.raspberrypi.com/raspios_lite_arm64_latest"

# Extra room for the system partition (PHYLAX Suite, kiosk and their libraries).
ROOT_GROW_MB=2048
# The data partition in the image. On the station's first boot it grows to fill the eMMC.
DATA_MB=256
DATA_LABEL=PHYLAXDATA

HOSTNAME=phylax-station
TIMEZONE=Asia/Bangkok
KEYBOARD_LAYOUT=us
WIFI_COUNTRY=TH

# DEV IMAGE ONLY: a login for SSH and the console (Ctrl+Alt+F2). Production images have none.
DEV_USER=admin
DEV_PASSWORD=123456
DEV_SSH=1

# The kiosk user: runs PHYLAX Suite, no login. Fixed ids, so the data partition fits every image.
KIOSK_USER=phylax
KIOSK_UID=1100
